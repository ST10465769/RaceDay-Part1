@model EventDto
<div class="card rd-card event-card h-100">
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <img alt src="@Model.BannerImageUrl.ImageSrc()" "@Model.EventName banner" />
    }
    else
    {
        <div class="event-banner-placeholder">@Model.EventType</div>
    }
    <div class="card-body d-flex flex-column">
        <span class="badge bg-dark align-self-start mb-2">@Model.EventType</span>
        <h5 class="card-title">@Model.EventName</h5>
        <p class="text-muted mb-1">@Model.EventDate.ToString("dd MMM yyyy") &middot; @Model.Location</p>
        <p class="mb-3">@Model.Distance.ToString("0.##") km</p>
        <a asp-controller="Participant" asp-action="EventDetails" asp-route-id="@Model.EventId" class="btn btn-rd mt-auto">View details</a>
    </div>
</div>
