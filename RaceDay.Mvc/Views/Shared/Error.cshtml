@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="text-center py-5">
    <h1 class="rd-title">Something went wrong</h1>
    <p class="lead">Sorry, we couldn't complete that. Please try again.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Go home</a>
</div>
