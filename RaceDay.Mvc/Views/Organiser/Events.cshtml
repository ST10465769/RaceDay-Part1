@model List<EventDto>
@{
    ViewData["Title"] = "Events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="rd-title mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-rd">+ New event</a>
</div>
<div class="card rd-card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No events yet. Create your first one.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th></th><th>Event</th><th>Date</th><th>Distance</th><th>Type</th><th>Enrolments</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.OrderBy(x => x.EventDate))
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(e.BannerImageUrl))
                                    {
                                        <img src="@e.BannerImageUrl.ImageSrc()" class="event-thumb" alt="banner" />
                                    }
                                </td>
                                <td><strong>@e.EventName</strong><br /><small class="text-muted">@e.Location</small></td>
                                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@e.Distance.ToString("0.##") km</td>
                                <td>@e.EventType</td>
                                <td>@e.EnrolmentCount</td>
                                <td class="text-end">
                                    <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-dark">Edit</a>
                                    <a asp-action="Categories" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-dark">Categories</a>
                                    <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this event, its categories and its enrolments?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div></div>