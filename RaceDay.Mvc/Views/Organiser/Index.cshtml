@model OrganiserDashboardVm
@{
    ViewData["Title"] = "Dashboard";
}
<h1 class="rd-title mb-4">Welcome back, @Model.DisplayName</h1>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card rd-card stat-card text-center p-3"><div class="stat-number">@Model.Events.Count</div><div>Events created</div></div></div>
    <div class="col-md-4"><div class="card rd-card stat-card text-center p-3"><div class="stat-number">@Model.TotalEnrolments</div><div>Total enrolments</div></div></div>
    <div class="col-md-4"><div class="card rd-card stat-card text-center p-3"><div class="stat-number">@Model.Upcoming.Count</div><div>Upcoming events</div></div></div>
</div>

<div class="card rd-card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Your events</h4>
            <a asp-action="CreateEvent" class="btn btn-rd">+ New event</a>
        </div>
        @if (!Model.Events.Any())
        {
            <p class="text-muted mb-0">You haven't created any events yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Enrolments</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Events.OrderBy(x => x.EventDate))
                        {
                            <tr>
                                <td><strong>@e.EventName</strong><br /><small class="text-muted">@e.Location</small></td>
                                <td>
                                    @e.EventDate.ToString("dd MMM yyyy")
                                    @if (e.EventDate >= DateTime.Today)
                                    {
                                        <span class="badge bg-success">Upcoming</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-secondary">Past</span>
                                    }
                                </td>
                                <td>@e.EventType</td>
                                <td>@e.EnrolmentCount</td>
                                <td class="text-end">
                                    <a asp-action="Enrolments" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-dark">Enrolments</a>
                                    <a asp-action="Results" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-dark">Results</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div></div>