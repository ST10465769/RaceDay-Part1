@model EventFormVm
@{
    string formAction = ViewData["FormAction"]?.ToString() ?? "CreateEvent";
}
<form asp-action="@formAction" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="EventId" />
    <input type="hidden" asp-for="BannerImageUrl" />
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="EventName" class="form-label"></label>
            <input asp-for="EventName" class="form-control" />
            <span asp-validation-for="EventName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" rows="3" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="EventDate" class="form-label"></label>
            <input asp-for="EventDate" type="date" class="form-control" />
            <span asp-validation-for="EventDate" class="text-danger"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Distance" class="form-label"></label>
            <input asp-for="Distance" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label class="form-label">Event banner (JPG, PNG, GIF or WebP, 5 MB at most)</label>
            @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
            {
                <div class="mb-2"><img src="@Model.BannerImageUrl" class="event-hero-img" style="max-height:140px;width:auto;" alt="Current banner" /></div>
            }
            <input type="file" name="banner" class="form-control" accept="image/*" />
        </div>
    </div>
    <button type="submit" class="btn btn-rd mt-4">Save event</button>
    <a asp-action="Events" class="btn btn-outline-secondary mt-4">Cancel</a>
</form>
