@model ParticipantEventsVm
@{
    ViewData["Title"] = "Upcoming events";
}
<h1 class="rd-title mb-3">Upcoming events</h1>

<form method="get" asp-action="Index" class="card rd-card p-3 mb-4">
    <div class="row g-2">
        <div class="col-md-6"><input name="search" value="@Model.Search" class="form-control" placeholder="Search by name or location" /></div>
        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.Type == "Run")">Run</option>
                <option value="Walk" selected="@(Model.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-rd">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">No upcoming events match your search.</div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model.Events.OrderBy(x => x.EventDate))
        {
            <div class="col-md-6 col-lg-4"><partial name="_EventCard" model="e" /></div>
        }
    </div>
}