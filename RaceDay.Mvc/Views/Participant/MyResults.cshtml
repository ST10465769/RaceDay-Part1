@model List<ResultDto>
@functions {
    // 1 -> 1st, 2 -> 2nd, 3 -> 3rd, 11 -> 11th and so on
    static string Ordinal(int n)
    {
        if (n % 100 is >= 11 and <= 13) return n + "th";
        return (n % 10) switch { 1 => n + "st", 2 => n + "nd", 3 => n + "rd", _ => n + "th" };
    }
}
@{
    ViewData["Title"] = "My results";
}
<h1 class="rd-title mb-3">My results</h1>
<div class="card rd-card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No results yet. Results appear here after an organiser records them.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.OrderByDescending(x => x.EventDate))
                        {
                            <tr>
                                <td><strong>@r.EventName</strong></td>
                                <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@r.CategoryName</td>
                                <td>@r.FinishTime.ToString("c")</td>
                                <td>@Ordinal(r.FinishingPosition)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div></div>