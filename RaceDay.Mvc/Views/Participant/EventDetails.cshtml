@model EventDetailsVm
@{
    ViewData["Title"] = Model.Event.EventName;
}
<a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">&laquo; All events</a>
<div class="row g-4">
    <div class="col-lg-8">
        @if (!string.IsNullOrWhiteSpace(Model.Event.BannerImageUrl))
        {
            <img src="@Model.Event.BannerImageUrl.ImageSrc()" alt="@Model.Event.EventName banner" class="event-hero-img" />
        }
        else
        {
            <div class="event-banner-placeholder" style="height:220px;border-radius:12px;">@Model.Event.EventType</div>
        }
        <h1 class="rd-title mt-3">@Model.Event.EventName</h1>
        <span class="badge bg-dark mb-2">@Model.Event.EventType</span>
        <p class="mt-2">@Model.Event.Description</p>
        <ul class="list-unstyled">
            <li><strong>Date:</strong> @Model.Event.EventDate.ToString("dddd, dd MMMM yyyy")</li>
            <li><strong>Location:</strong> @Model.Event.Location</li>
            <li><strong>Distance:</strong> @Model.Event.Distance.ToString("0.##") km</li>
            <li><strong>Organiser:</strong> @Model.Event.OrganiserName</li>
            <li><strong>Entries so far:</strong> @Model.Event.EnrolmentCount</li>
        </ul>
    </div>
    <div class="col-lg-4">
        <div class="card rd-card">
            <div class="card-body">
                <h4>Enter this event</h4>
                @if (Model.MyEnrolment != null)
                {
                    <p class="mb-1">You are entered in <strong>@Model.MyEnrolment.CategoryName</strong>.</p>
                    <partial name="_StatusBadge" model="Model.MyEnrolment.Status" />
                    <div class="mt-3"><a asp-action="MyEvents" class="btn btn-outline-dark btn-sm">See my events</a></div>
                }
                else if (Model.Event.EventDate < DateTime.Today)
                {
                    <p class="text-muted mb-0">This event has already taken place.</p>
                }
                else if (!Model.Event.Categories.Any())
                {
                    <p class="text-muted mb-0">The organiser hasn't added any categories yet.</p>
                }
                else
                {
                    <form asp-action="EnterEvent" method="post">
                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                        <p class="mb-2">Choose your category:</p>
                        @foreach (var c in Model.Event.Categories)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryId" id="cat@(c.CategoryId)" value="@c.CategoryId" required />
                                <label class="form-check-label" for="cat@(c.CategoryId)">
                                    @c.CategoryName <small class="text-muted">@c.Description</small>
                                </label>
                            </div>
                        }
                        <button type="submit" class="btn btn-rd w-100 mt-3">Enter event</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>