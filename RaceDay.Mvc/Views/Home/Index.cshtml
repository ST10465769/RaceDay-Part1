@{
    ViewData["Title"] = "Welcome";
}
<div class="rd-hero">
    <h1 class="display-4">Your next finish line is on <span class="accent">RaceDay</span></h1>
    <p class="lead mb-4">Browse running, walking and cycling events across South Africa, enter in minutes and track every result.</p>
    <a asp-controller="Auth" asp-action="Register" class="btn btn-rd btn-lg me-2">Create an account</a>
    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-lg">Log in</a>
</div>
